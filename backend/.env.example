ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://calendar_agent:calendar_agent@localhost:5434/calendar_agent
CORS_ORIGINS=["http://localhost"]

# Use one or both. Keys are never exposed to the iOS app in the default mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Set for any deployment reachable outside your local machine.
APP_SHARED_SECRET=

# Development-only option for a runtime key stored in iOS Keychain.
ALLOW_BYOK=false

# Stateless by default. Enabling this requires PostgreSQL and migrations.
AUDIT_PERSISTENCE_ENABLED=false

MAX_PROPOSALS=5
PLANNING_HORIZON_DAYS=14
MAX_BLOCK_MINUTES=240
